<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (dataExtractionRules). Same reasoning as backup_rules.xml: the access
  token stays on the device it was issued to, for both cloud backup and
  device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="duet_secure_session.xml" />
        <exclude domain="sharedpref" path="duet_secure_session_fallback.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="duet_secure_session.xml" />
        <exclude domain="sharedpref" path="duet_secure_session_fallback.xml" />
    </device-transfer>
</data-extraction-rules>
